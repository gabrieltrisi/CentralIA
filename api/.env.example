# ===== App =====
NODE_ENV=development
# Render injeta PORT automaticamente; localmente usa 3001.
PORT=3001
# URL do frontend (Vercel) — é adicionada ao CORS e ao Socket.IO em produção.
# Ex.: https://centralia.vercel.app
FRONTEND_URL=
# Lista adicional de origens permitidas (separadas por vírgula). Nunca use "*".
CORS_ORIGINS=http://localhost:3000
# live | sandbox  (sandbox não executa efeitos externos reais)
APP_MODE=sandbox
# Liga a máquina de estado persistente da conversa
USE_FSM=false

# ===== PostgreSQL =====
# LOCAL: host 5544 (compose mapeia 5544->5432) p/ evitar conflito com Postgres nativo na 5432.
# PRODUÇÃO (Neon): use a connection string do Neon com SSL, ex.:
#   postgresql://USER:PASS@ep-xxx.sa-east-1.aws.neon.tech/centralia?sslmode=require
DATABASE_URL="postgresql://centralia:centralia@localhost:5544/centralia?schema=public"

# ===== Redis / BullMQ =====
# Em produção (Upstash/Render) use REDIS_URL — tem PRIORIDADE sobre host/port.
# Upstash usa TLS: rediss://default:SENHA@HOST:PORT  (detecção de TLS automática)
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== Tenant padrão =====
DEFAULT_COMPANY_NAME=CentralIA

# ===== ISPBOX API V2 =====
ISPBOX_BASE_URL=
ISPBOX_CLIENT_ID=
ISPBOX_CLIENT_SECRET=
ISPBOX_SCOPES=
ISPBOX_REQUEST_ID=ispbox
# Id do tipo de OS usado pelo agente de suporte (ver GET /ispbox/ordens-servicos/tipos)
ISPBOX_DEFAULT_OS_TYPE=
# Liga as LEITURAS reais da ISPBOX (em sandbox sempre usa o mock)
ISPBOX_ENABLED=true

# ===== Ações sensíveis (escritas reais — exigem flag explícita) =====
# Geração de PIX/PDF de pagamento em production
FINANCIAL_ALLOW_PAYMENT_ACTIONS=false
# Abertura de OS real em production
SUPPORT_ALLOW_OS_CREATION=false
# Em PILOT_MODE, libera escritas ISPBOX (PIX/PDF/OS) p/ telefones permitidos
PILOT_ALLOW_ISPBOX_WRITE=false

# ===== Piloto controlado (Pilot 0.1) =====
# Em PILOT_MODE=true, SOMENTE telefones da allowlist são processados (inbound).
# Telefone do piloto informado: 71991674248 → normalizado p/ E.164 BR: 5571991674248.
# Aceita com/sem 55, espaços, parênteses e hífen (normalização interna).
PILOT_MODE=true
PILOT_ALLOWED_PHONES=5571991674248
# Envio de teste à Meta (mantém seguro: sandbox simula; produção exige flag).
PILOT_ALLOW_META_SEND=false
PILOT_FORCE_SANDBOX_SEND=false
PILOT_TEST_PHONE=5571991674248

# ===== AI (Anthropic / Claude) =====
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8
# Limiar de confiança do supervisor (abaixo disso escala humano)
AI_CONFIDENCE_THRESHOLD=0.7

# ===== Meta WhatsApp Cloud API =====
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v21.0
# Segredo do app Meta (validação HMAC do webhook)
META_APP_SECRET=
# Em sandbox, permite pular a validação de assinatura (NUNCA usar em produção)
META_WEBHOOK_SIGNATURE_BYPASS=true

# ===== Bull Board (dashboard de filas) =====
# Em sandbox o dashboard é aberto (conveniência). Em PRODUÇÃO defina usuário/senha
# para proteger /admin/queues (sem credenciais em produção, o dashboard NÃO é montado).
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=

# ===== Storage de anexos =====
# local | mock | s3 (vazio = mock em sandbox, local fora)
STORAGE_DRIVER=
STORAGE_DIR=./storage
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ===== Anexos (share-link) =====
ATTACHMENT_SIGNING_SECRET=troque-em-producao
ATTACHMENT_SHARE_TTL=900
# Chave para operações internas (criar share-link). Vazio = liberado só em sandbox.
INTERNAL_API_KEY=

# ===== Rate limit =====
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ===== Auth (JWT) =====
# Gere segredos fortes em produção (ex.: openssl rand -base64 48).
JWT_SECRET=troque-em-producao
# Segredo separado do refresh token (cai para JWT_SECRET se vazio).
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
